<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Deep link fixtures for ManifestReaderTests. Keep in sync with its expected trees. -->
        <activity
            android:name="com.infinum.sentinel.data.sources.raw.deeplinks.fixtures.FixtureLinksActivity"
            android:exported="true"
            android:label="Fixture links">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="example.com" />
                <data android:pathPrefix="/orders/" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:scheme="sentineltest"
                    android:host="@string/sentinel_test_deep_link_host"
                    android:path="/item" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="*.example.com"
                    android:pathPattern="/p/.*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="docs.example.com"
                    android:port="8443" />
                <data android:pathSuffix=".pdf" />
                <data android:pathAdvancedPattern="/a/[0-9]+" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="group.example.com" />
                <uri-relative-filter-group android:allow="true">
                    <data android:path="/group" />
                    <data android:query="id=*" />
                </uri-relative-filter-group>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.infinum.sentinel.data.sources.raw.deeplinks.fixtures.FixtureHiddenActivity"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="hiddentest" android:host="hidden" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.infinum.sentinel.data.sources.raw.deeplinks.fixtures.FixtureSentinelMarkedActivity"
            android:exported="true">
            <meta-data
                android:name="@string/sentinel_infinum_monitored"
                android:value="false" />
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="markedtest" android:host="marked" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name="com.infinum.sentinel.data.sources.raw.deeplinks.fixtures.FixtureAlias"
            android:exported="true"
            android:targetActivity="com.infinum.sentinel.data.sources.raw.deeplinks.fixtures.FixtureLinksActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="aliastest" android:host="alias" />
            </intent-filter>
        </activity-alias>
    </application>

</manifest>
